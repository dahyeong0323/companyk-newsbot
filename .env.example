# Reserved for later runtime integrations. Do not put real secrets in this file.
NEWSBOT_MODE=local
# Required only for Step 6+ Route B LLM judging. Leave blank for fixture tests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60
# Route A-only is the production default. Legacy Route B is lazy-loaded only
# when this explicit rollback/experiment flag is enabled.
PORTFOLIO_REGISTRY_PATH=config/portfolio_registry.yaml
ROUTE_B_ENABLED=false
ROUTE_A_EVENT_RESOLVER_ENABLED=false
ENRICHMENT_CONCURRENCY=8
ENRICHMENT_PER_HOST_CONCURRENCY=2
ENRICHMENT_TIMEOUT_SECONDS=8
ENRICHMENT_MAX_REDIRECTS=4
ENRICHMENT_HOST_FAILURE_THRESHOLD=3
DIRECT_EVENT_MODEL=gpt-5.6-luna
DIRECT_EVENT_REASONING=low
DIRECT_GROUNDING_MODEL=gpt-5.6-luna
DIRECT_GROUNDING_REASONING=low
# Optional versioned cost estimation. Either leave all blank or configure all
# rates for both direct stages; token telemetry is always recorded.
OPENAI_PRICING_VERSION=
DIRECT_EVENT_INPUT_USD_PER_MILLION=
DIRECT_EVENT_CACHED_INPUT_USD_PER_MILLION=
DIRECT_EVENT_OUTPUT_USD_PER_MILLION=
DIRECT_GROUNDING_INPUT_USD_PER_MILLION=
DIRECT_GROUNDING_CACHED_INPUT_USD_PER_MILLION=
DIRECT_GROUNDING_OUTPUT_USD_PER_MILLION=
# Cost-first production path. Set false for the frozen c8783a8 rollback classifier.
NEWSBOT_COST_FIRST_PIPELINE=true
ROUTE_B_NANO_MODEL=gpt-5.4-nano
ROUTE_B_NANO_REASONING=low
ROUTE_B_LUNA_MODEL=gpt-5.6-luna
ROUTE_B_LUNA_REASONING=low
NANO_CONCURRENCY=48
NANO_RPM_BUDGET=600
NANO_REQUEST_TIMEOUT_SECONDS=20
LUNA_ESCALATION_CONCURRENCY=16
LUNA_ESCALATION_RPM_BUDGET=300
LUNA_ESCALATION_TIMEOUT_SECONDS=30
# Frozen rollback classifier settings (used only when NEWSBOT_COST_FIRST_PIPELINE=false).
ROUTE_B_PRIMARY_MODEL=gpt-5.6-luna
ROUTE_B_PRIMARY_REASONING=medium
ROUTE_B_FALLBACK_MODEL=gpt-5.6-sol
ROUTE_B_FALLBACK_REASONING=medium
LUNA_CONCURRENCY=32
SOL_CONCURRENCY=8
LUNA_RPM_BUDGET=400
SOL_RPM_BUDGET=120
LUNA_REQUEST_TIMEOUT_SECONDS=30
SOL_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Final ranked-event editor and grounding verifier (explicitly independent from Route B judge models).
SUMMARY_MODEL=gpt-5.6-luna
SUMMARY_REASONING=low
SUMMARY_CONCURRENCY=4
GROUNDING_MODEL=gpt-5.6-luna
GROUNDING_REASONING=low
EVENT_RESOLVER_MODEL=gpt-5.6-luna
EVENT_RESOLVER_REASONING=low
# Full Shadow refuses to run unless this is set to a mounted Volume, e.g. /data/artifacts.
ARTIFACT_DIR=
# Offline baseline comparison; this does not collect RSS or call Sol.
CASCADE_REPLAY_ARTIFACT=
CASCADE_REPLAY_OUTPUT=artifacts/luna_replay.json
RUN_MODE=shadow
# Required for Railway's scheduled production job. The application also blocks
# live starts outside the 07:55-08:15 Asia/Seoul scheduler tolerance window.
PRODUCTION_EMAIL_ENABLED=false
SHADOW_TEST_EMAIL=false
STATE_DIR=.state
E2E_DIRECT_QUERY_CAP=8
E2E_EXPOSURE_QUERY_CAP=8
E2E_SMOKE_LOOKBACK_DAYS=7
FRESHNESS_FIRST_RUN_HOURS=30
FRESHNESS_OVERLAP_HOURS=2
# A briefing is valid only when this fraction of configured RSS queries succeeds.
RSS_MIN_SUCCESS_RATIO=0.90
# Required only for a controlled delivery test or the future live schedule.
RESEND_API_KEY=
NEWSBOT_RECIPIENT=jeremy.cheon@pm.me,taejin3789@naver.com
EMAIL_FROM=Company K Newsbot <onboarding@resend.dev>
