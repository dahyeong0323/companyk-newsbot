# Reserved for later runtime integrations. Do not put real secrets in this file.
NEWSBOT_MODE=local
# Required only for Step 6+ Route B LLM judging. Leave blank for fixture tests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60
# Route B cascade (Luna is primary; Sol only judges Luna escalation or technical failure).
ROUTE_B_PRIMARY_MODEL=gpt-5.6-luna
ROUTE_B_PRIMARY_REASONING=medium
ROUTE_B_FALLBACK_MODEL=gpt-5.6-sol
ROUTE_B_FALLBACK_REASONING=medium
LUNA_CONCURRENCY=32
SOL_CONCURRENCY=8
LUNA_RPM_BUDGET=400
SOL_RPM_BUDGET=120
LUNA_REQUEST_TIMEOUT_SECONDS=30
SOL_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Final ranked-event editor (explicitly independent from Route B judge models).
SUMMARY_MODEL=gpt-5.6-sol
SUMMARY_REASONING=medium
SUMMARY_CONCURRENCY=4
GROUNDING_MODEL=gpt-5.6-luna
GROUNDING_REASONING=medium
# Full Shadow refuses to run unless this is set to a mounted Volume, e.g. /data/artifacts.
ARTIFACT_DIR=
# Offline baseline comparison; this does not collect RSS or call Sol.
CASCADE_REPLAY_ARTIFACT=
CASCADE_REPLAY_OUTPUT=artifacts/luna_replay.json
RUN_MODE=shadow
STATE_DIR=.state
E2E_DIRECT_QUERY_CAP=8
E2E_EXPOSURE_QUERY_CAP=8
E2E_SMOKE_LOOKBACK_DAYS=7
FRESHNESS_FIRST_RUN_HOURS=30
FRESHNESS_OVERLAP_HOURS=2
# Required only for a controlled delivery test or the future live schedule.
RESEND_API_KEY=
NEWSBOT_RECIPIENT=jeremy.cheon@pm.me
EMAIL_FROM=Company K Newsbot <onboarding@resend.dev>
